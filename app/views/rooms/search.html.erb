<div class="container my-5">
  <%= form_with url: search_rooms_path, method: :get, local: true, class: "row g-2 mb-4" do |f| %>
    <div class="col-md-5">
      <%= f.text_field :area, placeholder: "東京・大阪・札幌・京都 もしくは住所を入力", class: "form-control" %>
    </div>
    <div class="col-md-5">
      <%= f.text_field :keyword, placeholder: "キーワード検索", class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.submit "検索", class: "search-btn py-2 rounded btn-lg w-100" %>
    </div>
  <% end %>

  <p class="mb-3 fw-bold"><%= @rooms.count %>件見つかりました</p>
</div>
<div class="container mb-5">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% @rooms.each do |room| %>
      <div class="col">
        <div class="card h-100 shadow-sm">
          <% if room.image.attached? %>
            <%= image_tag room.image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% else %>
            <%= image_tag "default_image.png", class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% end %>

          <div class="card-body">
            <div class="card-title fs-5">
              <%= link_to room.name, room_path(room), class: "text-decoration-none text-primary" %>
            </div>
            <p class="card-text text-muted mb-1"><%= room.address %></p>
            <p class="card-text mb-2"><%= truncate(room.description, length: 70) %></p>
            <p class="fw-bold mb-0">¥<%= number_with_delimiter(room.price) %> /日</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div> 