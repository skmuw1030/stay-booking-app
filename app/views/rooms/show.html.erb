<% if @room.image.attached? %>
  <%= image_tag @room.image %>
<% else %>
  <%= image_tag "default_image.png" %>
<% end %>

<%= @room.name %>

<p>紹介文：<%= @room.description %></p>
<p>料金：<%= number_to_currency(@room.price, unit: "¥", precision: 0) %>/日</p>
<p>住所：<%= @room.address %></p>
<p>作成日：<%= @room.created_at.strftime("%Y/%m/%d") %></p>

<%= link_to "戻る", request.referer || rooms_path %>