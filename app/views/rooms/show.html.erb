<div class="container my-5">

  <div class="row">

    <div class="col-md-7"> 
      <% if @room.image.attached? %>
        <%= image_tag @room.image, class: "img-fluid rounded shadow-sm mb-3", style: "height: 300px; width: 100%; object-fit: cover;" %>
      <% else %>
        <%= image_tag "default_image.png", class: "img-fluid rounded shadow-sm mb-3", style: "height: 300px; width: 100%; object-fit: cover;" %>
      <% end %>

      <h3 class="fw-bold"><%= @room.name %></h3>
      <p class="text-muted"><%= @room.address %></p>

      <div class="card p-3 mb-3 border-0 shadow-sm">
        <p class="fw-bold mb-2">紹介文</p>
        <p><%= @room.description %></p>
      </div>

      <div class="card p-3 border-0 shadow-sm bg-light">
        <h5 class="mb-2 text-primary">
          ¥<%= number_to_currency(@room.price, precision: 0) %> / 日
        </h5>
        <p class="text-muted fs-7">
          ※1人1泊の料金です<br>
          ※合計金額は日数・人数に応じて計算されます
        </p>
      </div>
    </div>


    <div class="col-md-5">
      <div class="card p-4 shadow-sm border-0">

      <h5 class="mb-3">予約する</h5>

      <%= form_with model: @reservation, url: confirm_reservations_path, data: { turbo: false } do |f| %>

        <%= f.hidden_field :room_id, value: @room.id %>

        <div class="mb-3">
          <%= f.label :check_in, "チェックイン", class: "form-label" %>
          <%= f.date_field :check_in, class: "form-control" %>
          <% if @reservation.errors[:check_in].any? %>
            <div class="text-danger small">
              <%= @reservation.errors.full_messages_for(:check_in).first %>
            </div>
          <% end %>
        </div>
  
        <div class="mb-3">
          <%= f.label :check_out, "チェックアウト", class: "form-label" %>
          <%= f.date_field :check_out, class: "form-control" %>
          <% if @reservation.errors[:check_out].any? %>
            <div class="text-danger small">
              <%= @reservation.errors.full_messages_for(:check_out).first %>
            </div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.label :number_of_people, "人数", class: "form-label" %>
          <%= f.number_field :number_of_people, class: "form-control" %>
          <% if @reservation.errors[:number_of_people].any? %>
            <div class="text-danger small">
              <%= @reservation.errors.full_messages_for(:number_of_people).first %>
            </div>
          <% end %>
        </div>

        <%= f.submit "予約する", class: "btn btn-success py-2 w-100" %>
      <% end %>
    </div>
  </div>
  
  <div class="mt-3">
    <%= link_to (request.referer || rooms_path), class: "text-decoration-none" do %>
      <i class="bi bi-arrow-left me-2"></i>戻る
    <% end %>
  </div>
</div>