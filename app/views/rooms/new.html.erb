<h2 class="text-center my-4">新しい施設を作成</h2>

<div class="container" style="max-width: 700px;">
  <%= form_with model: @room, class: "card p-4 shadow-sm border-0", local: true do |f| %>

    <div class="mb-4">
      <%= f.label :name, "施設名", class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control" %> 

      <% if @room.errors[:name].any? %>
        <div class="text-danger small mt-1">
          <% @room.errors.full_messages_for(:name).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "施設詳細", class: "form-label fw-bold" %>
      <%= f.text_area :description, class: "form-control", rows: 4 %>

      <% if @room.errors[:description].any? %>
        <div class="text-danger small mt-1">
          <% @room.errors.full_messages_for(:description).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :price, "料金（/日）", class: "form-label fw-bold" %>
      <%= f.text_field :price, class: "form-control" %>

      <% if @room.errors[:price].any? %>
        <div class="text-danger small mt-1">
          <%= @room.errors.full_messages_for(:price).first %>
        </div>
      <% end %>
    </div>
    
    <div class="mb-4">
      <%= f.label :address, "住所", class: "form-label fw-bold" %>
      <%= f.text_field :address, class: "form-control" %>

      <% if @room.errors[:address].any? %>
        <div class="text-danger small mt-1">
          <% @room.errors.full_messages_for(:address).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :image, "施設画像", class: "form-label fw-bold" %>
      <%= f.file_field :image, class: "form-control" %>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit "作成", class: "btn btn-primary ppy-2 w-100" %>
      <%= link_to "キャンセル", request.referrer || rooms_path, class: "btn btn-outline-secondary py-2 w-100" %>
    </div>
  <% end %>
</div>