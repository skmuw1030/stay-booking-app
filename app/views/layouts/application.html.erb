<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Stay Booking App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  </head>

  <body>
    <header class="shadow py-4">
      <div class="container-fluid px-4">

        <div class="d-flex justify-content-between align-items-center ">
          <%= link_to root_path,class:"text-white fs-4 fw-bold text-decoration-none" do %>
            <i class="bi bi-house-fill fs-4 me-2"></i>
            StayBook
          <% end %>

          <% if session[:user_id] %>
            <% user = User.find(session[:user_id]) %>

            <div class="dropdown">
              <a class="dropdown-toggle text-white text-decoration-none d-flex align-items-center"
                href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
          

                <% if user.user_image.attached? %>
                  <%= image_tag user.user_image,width: 32,height:32, class:"rounded-circle me-2" %>
                <% else %>
                  <%= image_tag "default_icon.png",width: 32,height: 32, class:"rounded-circle me-2" %>
                <% end %>

                <%= user.name %>

              </a>

              <ul class="dropdown-menu py-2">
                <li><%= link_to "プロフィール画面", user_path(user),class:"dropdown-item" %></li>
                <li><%= link_to "アカウント画面",account_user_path(user),class:"dropdown-item"%></li>
                <li><%= link_to "新規施設登録", new_room_path, class:"dropdown-item" %></li>
                <li><%= link_to "登録済み施設一覧", rooms_path, class:"dropdown-item" %></li>
                <li><%= link_to "予約済み一覧", reservations_path, class:"dropdown-item" %></li>
                <li><%= button_to "ログアウト", logout_path, method: :delete, class:"dropdown-item border-0 bg-transparent text-start w-100 " %></li>
              </ul>
            </div>       

            <% else %>
              <div>
                <%= link_to "ログイン", login_path, class:"text-white fw-bold text-decoration-none me-3" %>
                <%= link_to "新規登録", new_user_path, class:"btn btn-outline-light fw-bold " %>
              </div>
            <% end %>
        </div>
      </div>
    </header>



    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
