<h2 class="text-center my-4">ログイン</h2>

<div class="container" style="max-width: 500px;">
  <%= form_with url: login_path, class: "card p-4 shadow-sm border-0" do |f| %>

    <div class="mb-3">
      <p class="fw-bold">メールアドレス</p>
      <%= f.email_field :email, class: "form-control" %>
    </div>

    <div class="mb-3">
      <p class="fw-bold">パスワード</p>
      <%= f.password_field :password, class: "form-control" %>
    </div>

    <div class="mt-3">
      <%= f.submit "ログイン", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <div class="text-center mt-3">
    <%= link_to "新規登録はこちら", new_user_path, class: "text-decoration-none" %>
  </div>
</div>
