<h2>予約済み一覧</h2>

<% @reservations.each do |reservation| %>
  
  <% if reservation.room.image.attached? %>
    <%= image_tag reservation.room.image %>
  <% else %>
    <%= image_tag "default_image.png" %>
  <% end %>

  <p>施設名：<%= reservation.room.name %></p>

  <p>紹介文：<%= reservation.room.description %></p>

  <p>合計料金：¥<%= number_with_delimiter(reservation.total_price) %></p>

  <p>チェックイン：<%= reservation.check_in.strftime("%Y/%m/%d") %></p>

  <p>チェックアウト：<%= reservation.check_out.strftime("%Y/%m/%d") %></p>

  <p>予約人数：<%= reservation.number_of_people %>人</p>

  <p>予約確定日時：<%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>

<% end %>
