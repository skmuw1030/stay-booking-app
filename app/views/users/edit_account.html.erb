<h2>アカウント編集</h2>

<%= form_with model: @user, url: update_account_user_path(@user), method: :patch do |f| %>
  <p>メールアドレス</p>
  <%= f.email_field :email %>
    
  <p>新しいパスワード</p>
  <%= f.password_field :password %>

  <p>確認用パスワード</p>
  <%= f.password_field :password_confirmation %>
    
    
  <%= f.submit "更新" %>
  <%= link_to "アカウントページに戻る", account_user_path(@user) %> 
    
  <% end %>