<div class="container my-5">
  <div class="account-edit d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">アカウント編集</h2>
    <%= link_to account_user_path(@user), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-backspace me-2"></i> 戻る 
    <% end %>
  </div>

  <div class="card account-edit-card mx-auto p-4 shadow" >
    <%= form_with model: @user, url: update_account_user_path(@user), method: :patch do |f| %>

      <div class="row mb-3 align-items-center">
        <p class="col-4 fw-bold text-primary">メールアドレス</p>
        <div class="col-6">
          <%= f.email_field :email, class: "form-control" %>
        </div>
      </div>

      <div class="row mb-3 align-items-center"> 
        <p class="col-4 fw-bold text-primary">新しいパスワード</p>
        <div class="col-6">
          <%= f.password_field :password, class: "form-control" %>
        </div>
      </div>

      <div class="row mb-3 align-items-center">
        <p class="col-4 fw-bold text-primary">確認用パスワード</p>
        <div class="col-6">
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
      </div> 
  
      <div class="text-end">
        <%= f.submit "更新", class: "btn btn-primary" %>
      </div>
     
    <% end %>
  め</div>
</div>