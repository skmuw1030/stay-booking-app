<h2 class="text-center my-4">プロフィール編集</h2>

<div class="container" style="max-width: 500px;">
  <%= form_with model: @user, html: { multipart: true },class: "card p-4 shadow-sm border-0" do |f| %>

    <% if @user.user_image.attached? && @user.user_image.blob&.persisted? %>
      <div class="text-center mb-3">
        <%= image_tag @user.user_image, class: "rounded-circle", width: 100, height: 100 %>
      </div>
    <% else %>
      <div class="text-center mb-3">
        <%= image_tag "default_icon.png", class: "rounded-circle", width: 100, height: 100 %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :user_image, "アイコン画像", class: "form-label fw-bold" %>
      <%= f.file_field :user_image, class: "form-control" %>
    </div>
  
    <div class="mb-3">
      <%= f.label :name, "名前", class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :profile, "自己紹介", class: "form-label fw-bold" %>
      <%= f.text_area :profile, class: "form-control" %>
    </div>

    <div class="mt-3">
      <%= f.submit "更新", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <div class="text-center mt-3">
    <%= link_to "キャンセル", users_path, class: "text-decoration-none" %>
  </div>
</div>