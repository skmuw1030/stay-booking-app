<h2 class="text-center my-4">新規登録</h2>

<div class="container" style="max-width: 500px;">
  <%= form_with model: @user, class: "card p-4 shadow-sm" do |f| %>

    <div class="mb-2">
      <p class="fw-bold">ユーザー名<span class="text-danger">*</span></p>
      <%= f.text_field :name, class: "form-control" %>

      <% if @user.errors[:name].any? %>
        <div class="text-danger small mt-1">
          <% @user.errors.full_messages_for(:name).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-2">
      <p class="fw-bold">メールアドレス<span class="text-danger">*</span></p>
      <%= f.email_field :email, class: "form-control" %>

      <% if @user.errors[:email].any? %>
        <div class="text-danger small mt-1">
          <% @user.errors.full_messages_for(:email).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-2">
      <p class="fw-bold">パスワード<span class="text-danger">*</span></p>
      <%= f.password_field :password, class: "form-control" %>

      <% if @user.errors[:password].any? %>
        <div class="text-danger small mt-1">
          <% @user.errors.full_messages_for(:password).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-2">
      <p class="fw-bold">確認用パスワード<span class="text-danger">*</span></p>
      <%= f.password_field :password_confirmation, class: "form-control" %>

      <% if @user.errors[:password_confirmation].any? %>
        <div class="text-danger small mt-1">
          <% @user.errors.full_messages_for(:password_confirmation).each do |message| %>
            <%= message %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-3">
      <%= f.submit "新しいアカウントを作成", class: "btn btn-primary w-100 py-2" %>
    </div>
  <% end %>
    
  <div class="text-center mt-3">
    <%= link_to "ログインはこちら", login_path, class: "text-decoration-none" %>
  </div>
</div>