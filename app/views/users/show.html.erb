<div class="container my-5">

  <div class="profile-button d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">プロフィール</h2>
    <%= link_to edit_user_path(@user), class: "btn btn-outline-primary" do %>
       <i class="bi bi-pencil me-2"></i> 編集
    <% end %>
  </div>

  <div class="card profile-card mx-auto p-4 shadow">
    <div class="row align-items-start">

      <div class="col-md-3">
        <% if @user.user_image.attached? %>
          <%= image_tag @user.user_image, class: "rounded-circle" %>
        <% else %>
          <%= image_tag "default_icon.png",class: "rounded-circle" %>
        <% end %>
      </div>

      <div class="col-md-9 d-flex flex-column justify-content-start ps-4">
        <div class="mb-3">
          <h5 class="fw-bold mb-1">名前</h5>
          <p class="h5 mb-3"><%= @user.name %></p>
        </div>

        <div class="mb-3">
          <h5 class="fw-bold mb-1">自己紹介</h5>
          <p class="text-muted"><%= @user.profile %></p>
        </div>
      </div>

    </div>
  </div>

</div>

