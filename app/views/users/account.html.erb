<div class="container my-5">
  <div class="account-button d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">アカウント情報</h2>
    <%= link_to edit_account_user_path(@user), class: "btn btn-outline-primary" do %>
      <i class="bi bi-pencil me-2"></i> 編集
    <% end %>
  </div>

  <div class="card account-card mx-auto p-4 shadow" >
    <div class="row mb-3">
      <div class="col-3 fw-bold text-primary">メールアドレス</div>
      <div class="col-5 text-muted"><%= @user.email %></div>
    </div>

    <div class="row">
      <div class="col-3 fw-bold text-primary">パスワード</div>
      <div class="col-5 text-muted">********</div>
    </div>
  </div>
</div>

